generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Core ──────────────────────────────────────────────────────────────

model Empresa {
  id                           String   @id @default(uuid())
  razon_social                 String
  rut                          String   @unique
  giro                         String?
  domicilio_legal              String?
  telefono                     String   @default("")
  email                        String?
  representante_legal_nombre   String   @default("")
  representante_legal_rut      String   @default("")
  representante_legal_telefono String?
  notas_internas               String?
  created_at                   DateTime @default(now())

  locales Tenant[]

  @@index([razon_social])
}

model Tenant {
  id                 String   @id @default(uuid())
  empresa_id         String
  nombre             String
  rut                String   // copia del RUT de Empresa — sello, selector y PDFs
  direccion          String
  ciudad             String   @default("Osorno")
  telefono           String   @default("")
  encargado_nombre   String?
  encargado_telefono String?
  plan               String   // 'calidad' | 'integral'
  tipo_local         String   @default("restaurante") // 'restaurante' | 'cafeteria' | 'cocineria' | 'food_truck'
  estado             String   @default("pendiente") // 'pendiente' | 'activo' | 'suspendido' | 'baja'
  created_at         DateTime @default(now())

  empresa           Empresa            @relation(fields: [empresa_id], references: [id])
  user_tenants      UserTenant[]
  gestion_ambiental GestionAmbiental[]
  fiscalizaciones   Fiscalizacion[]
  descargos         Descargo[]
  registros         Registro[]
  sellos            Sello[]
  documentos        Documento[]
  visitas           Visita[]
  mensajes          Mensaje[]
  tickets           Ticket[]
  notificaciones    Notificacion[]
  tareas            Tarea[]
  consentimientos   Consentimiento[]
  solicitudesArsopb SolicitudArsopb[]
  asignaciones      AsignacionAsesor[]
  suscripcion       Suscripcion?
  pagos             Pago[]
  configuracion_bpm ConfiguracionBpm?
  hallazgos         Hallazgo[]
  declaraciones     DeclaracionVeracidad[]
  proveedores       Proveedor[]
  capacitacion_registros CapacitacionRegistro[]

  @@index([rut])
  @@index([empresa_id])
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  nombre     String
  rol        String   // 'trabajador_local' | 'jefe_local' | 'admin_local' | 'asesor' | 'admin_nucleo'
  activo     Boolean  @default(true)
  created_at DateTime @default(now())

  user_tenants         UserTenant[]
  tarea_completaciones TareaCompletacion[]
  mensajes_enviados    Mensaje[]           @relation("MensajeRemitente")
  mensajes_recibidos   Mensaje[]           @relation("MensajeDestinatario")
  tickets_creados      Ticket[]            @relation("TicketAutor")
  tickets_asignados    Ticket[]            @relation("TicketAsignado")
  notificaciones       Notificacion[]
}

// Relación many-to-many User ↔ Tenant (soporta multi-local)
model UserTenant {
  id        String @id @default(uuid())
  user_id   String
  tenant_id String

  user   User   @relation(fields: [user_id], references: [id])
  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([user_id, tenant_id])
  @@index([user_id])
  @@index([tenant_id])
}

// Asignación de asesores a locales (N:M)
model AsignacionAsesor {
  id        String   @id @default(uuid())
  asesor_id String   // user.id con rol='asesor'
  tenant_id String
  activo    Boolean  @default(true)
  desde     DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([asesor_id, tenant_id])
  @@index([asesor_id])
  @@index([tenant_id])
}

// ── Sellos ────────────────────────────────────────────────────────────

model Sello {
  id                   String   @id @default(uuid())
  tenant_id            String
  periodo              String   // 'YYYY-MM'
  esquema              String   @default("v1") // 'v1' | 'v2'
  estado               String   @default("emitido") // 'propuesto' | 'emitido' | 'rechazado'
  nivel                String   // v1: inicial|intermedio|avanzado|premium — v2: sin_sello|bronce|plata|oro
  score_general        Float
  score_documentacion  Float    @default(0)
  score_condiciones    Float    @default(0)
  score_capacitaciones Float    @default(0)
  score_tareas         Float    @default(0)
  score_seguimiento    Float    @default(0)
  score_visita         Float    @default(0)
  scores_componentes   Json?
  bloqueo_critico      Boolean  @default(false)
  plan_mejoras         String[] @default([])
  descargos_habilitados Boolean @default(false)
  pesos_usados         Json
  inputs_snapshot      Json
  propuesto_por        String?
  aprobado_por         String?
  aprobado_at          DateTime?
  rechazo_motivo       String?
  emitido_por          String
  emitido_at           DateTime @default(now())

  revisiones RevisionSello[]
  tenant     Tenant          @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, periodo])
  @@index([tenant_id])
  @@index([estado])
}

model RevisionSello {
  id             String   @id @default(uuid())
  sello_id       String
  solicitado_por String
  motivo         String
  respuesta      String?
  estado         String   @default("pendiente") // 'pendiente' | 'resuelta'
  created_at     DateTime @default(now())

  sello Sello @relation(fields: [sello_id], references: [id])
}

model ConfiguracionSellos {
  id                   String   @id @default(uuid())
  peso_documentacion   Float    @default(0.30)
  peso_condiciones     Float    @default(0.25)
  peso_capacitaciones  Float    @default(0.25)
  peso_tareas          Float    @default(0.20)
  umbral_intermedio    Float    @default(60)
  umbral_avanzado      Float    @default(75)
  umbral_premium       Float    @default(90)
  updated_by           String
  updated_at           DateTime @updatedAt
}

// ── Registros BPM ─────────────────────────────────────────────────────

model Registro {
  id               String   @id @default(uuid())
  tenant_id        String
  tipo             String
  codigo           String?
  origen           String   @default("digital")
  fecha            DateTime
  datos            Json
  estado           String   @default("completo")
  observacion      String?
  adjunto_url      String?
  evidencia_estado String   @default("declarado_cliente") // 'declarado_cliente' | 'revisado_documental' | 'verificado_visita'
  extemporaneo     Boolean  @default(false)
  created_by       String
  created_at       DateTime @default(now())

  tenant   Tenant           @relation(fields: [tenant_id], references: [id])
  ediciones RegistroEdicion[]

  @@index([tenant_id])
  @@index([tenant_id, tipo])
  @@index([tenant_id, codigo])
}

model RegistroEdicion {
  id          String   @id @default(uuid())
  registro_id String
  actor_id    String
  motivo      String
  datos_antes Json
  created_at  DateTime @default(now())

  registro Registro @relation(fields: [registro_id], references: [id], onDelete: Cascade)

  @@index([registro_id, created_at])
}

model ConfiguracionBpm {
  id             String   @id @default(uuid())
  tenant_id      String   @unique
  equipos_frio   Json
  areas_limpieza Json
  programa       Json?
  updated_at     DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model Documento {
  id               String    @id @default(uuid())
  tenant_id        String
  nombre           String
  categoria        String
  mes              String    // 'YYYY-MM'
  url              String    // Cloudflare R2
  vencimiento      DateTime?
  estado           String    @default("pendiente") // 'pendiente' | 'aprobado' | 'observado' | 'rechazado'
  evidencia_estado String    @default("declarado_cliente")
  observacion      String?
  version          Int       @default(1)
  created_by       String
  created_at       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, mes])
}

model Visita {
  id                 String   @id @default(uuid())
  tenant_id          String
  asesor_id          String
  tipo               String   // 'programada' | 'sorpresa'
  estado             String   @default("realizada") // 'agendada' | 'realizada' | 'cancelada'
  fecha              DateTime
  motivo             String   @default("rutina") // 'rutina' | 'hallazgo' | 'seguimiento'
  hallazgo_origen_id String?
  hallazgos          String?
  evaluacion         Json?
  created_at         DateTime @default(now())

  no_conformidades NoConformidad[]
  hallazgos_v2     Hallazgo[]      @relation("HallazgoDeVisita")
  hallazgo_origen  Hallazgo?       @relation("VisitaPorHallazgo", fields: [hallazgo_origen_id], references: [id], onDelete: SetNull)
  tenant           Tenant          @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([hallazgo_origen_id])
}

model Hallazgo {
  id                    String    @id @default(uuid())
  tenant_id             String
  visita_id             String?
  proveedor_id          String?
  gravedad              String    // 'critico' | 'mayor' | 'menor'
  estado                String    @default("abierto")
  descripcion           String
  fundamento            String?
  ubicacion             String?
  observador_id         String
  responsable_id        String?
  plazo                 DateTime?
  fotos_iniciales       String[]  @default([])
  contencion            String?
  accion_correctiva     String?
  evidencia_cierre      String[]  @default([])
  evidencia_estado      String    @default("declarado_cliente")
  revisor_id            String?
  revision_at           DateTime?
  decision              String?
  motivo_decision       String?
  seguimiento_at        DateTime?
  seguimiento_resultado String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  tenant             Tenant           @relation(fields: [tenant_id], references: [id])
  visita             Visita?          @relation("HallazgoDeVisita", fields: [visita_id], references: [id])
  visitas_por_origen Visita[]         @relation("VisitaPorHallazgo")
  proveedor          Proveedor?       @relation(fields: [proveedor_id], references: [id])
  eventos            HallazgoEvento[]

  @@index([tenant_id, estado])
  @@index([tenant_id, gravedad])
  @@index([visita_id])
}

model HallazgoEvento {
  id          String   @id @default(uuid())
  hallazgo_id String
  actor_id    String
  de_estado   String?
  a_estado    String
  nota        String?
  created_at  DateTime @default(now())

  hallazgo Hallazgo @relation(fields: [hallazgo_id], references: [id], onDelete: Cascade)

  @@index([hallazgo_id, created_at])
}

model DeclaracionVeracidad {
  id           String   @id @default(uuid())
  tenant_id    String
  user_id      String
  tipo         String   // 'A' | 'B' | 'C' | 'D'
  version      String
  texto        String
  evento       String
  recurso_tipo String?
  recurso_id   String?
  created_at   DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, tipo])
  @@index([recurso_tipo, recurso_id])
}

model Proveedor {
  id                   String    @id @default(uuid())
  tenant_id            String
  razon_social         String
  rut                  String
  contacto             String?
  tipo_servicio        String
  autorizacion_entidad String?
  autorizacion_numero  String?
  autorizacion_fecha   DateTime?
  vigencia             DateTime?
  alcance              String?
  proxima_prestacion   DateTime?
  documentos           String[]  @default([])
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenant_id], references: [id])
  hallazgos Hallazgo[]

  @@index([tenant_id])
}

model CapacitacionContenido {
  id               String   @id @default(uuid())
  titulo           String
  descripcion      String
  url_recurso      String
  tipo_recurso     String   @default("video") // 'video' | 'presentacion'
  preguntas        Json     @default("[]")
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())

  registros CapacitacionRegistro[]
}

model CapacitacionRegistro {
  id           String   @id @default(uuid())
  contenido_id String
  tenant_id    String
  user_id      String
  puntaje      Int
  aprobado     Boolean
  created_at   DateTime @default(now())

  contenido CapacitacionContenido @relation(fields: [contenido_id], references: [id])
  tenant    Tenant                @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, user_id])
  @@index([contenido_id])
}

model AlertaResolucion {
  id         String   @id @default(uuid())
  tenant_id  String
  alerta_key String
  actor_id   String
  nota       String?
  created_at DateTime @default(now())

  @@index([tenant_id, alerta_key])
}

model NoConformidad {
  id                String    @id @default(uuid())
  visita_id         String
  descripcion       String
  area              String?
  severidad         String    // 'menor' | 'mayor'
  estado            String    @default("abierta") // 'abierta' | 'en_proceso' | 'cerrada'
  fecha_limite      DateTime?
  evidencia_cierre  String?
  cerrada_at        DateTime?

  visita Visita @relation(fields: [visita_id], references: [id])
}

model Ticket {
  id          String    @id @default(uuid())
  tenant_id   String
  creado_por  String    @db.Uuid
  asignado_a  String?   @db.Uuid
  asunto      String
  categoria   String    @default("consulta") // 'consulta' | 'incidencia' | 'documentos' | 'visita' | 'otro'
  estado      String    @default("abierta") // 'abierta' | 'en_atencion' | 'resuelta'
  prioridad   String    @default("normal") // 'normal' | 'urgente'
  adjuntos    String[]  @default([])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  resuelto_at DateTime?

  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  autor          User            @relation("TicketAutor", fields: [creado_por], references: [id])
  asignado       User?           @relation("TicketAsignado", fields: [asignado_a], references: [id])
  mensajes       Mensaje[]
  notificaciones Notificacion[]

  @@index([tenant_id, estado, updated_at])
  @@index([asignado_a, estado])
  @@index([creado_por])
}

model Mensaje {
  id          String   @id @default(uuid())
  tenant_id   String
  ticket_id   String?
  de          String   @db.Uuid // user_id
  para        String   @db.Uuid // user_id
  contenido   String
  adjunto_url String?
  adjuntos    String[] @default([])
  leido       Boolean  @default(false)
  created_at  DateTime @default(now())

  tenant       Tenant  @relation(fields: [tenant_id], references: [id])
  ticket       Ticket? @relation(fields: [ticket_id], references: [id])
  remitente    User    @relation("MensajeRemitente", fields: [de], references: [id])
  destinatario User    @relation("MensajeDestinatario", fields: [para], references: [id])

  @@index([tenant_id])
  @@index([ticket_id, created_at])
  @@index([de])
  @@index([para])
}

model Notificacion {
  id         String   @id @default(uuid())
  user_id    String   @db.Uuid
  tenant_id  String?
  ticket_id  String?
  tipo       String   // 'ticket_nueva' | 'ticket_respuesta' | 'ticket_estado'
  titulo     String
  cuerpo     String
  href       String
  leida      Boolean  @default(false)
  created_at DateTime @default(now())

  user   User    @relation(fields: [user_id], references: [id])
  tenant Tenant? @relation(fields: [tenant_id], references: [id])
  ticket Ticket? @relation(fields: [ticket_id], references: [id])

  @@index([user_id, leida, created_at])
  @@index([ticket_id])
}

// ── Compliance Ley 21.719 ─────────────────────────────────────────────

// Art. 12 — consentimiento expreso con registro de IP y versión del documento
model Consentimiento {
  id                String   @id @default(uuid())
  tenant_id         String
  titular_id        String   // user_id
  tipo              String   // 'otorgamiento' | 'revocacion' | 'actualizacion'
  documento_version String
  timestamp_evento  DateTime
  ip_origen         String
  canal             String   // 'web' | 'mobile_pwa'
  created_at        DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, titular_id])
}

// Art. 5, 6, 7, 9 — derechos ARSOPB del titular
model SolicitudArsopb {
  id              String    @id @default(uuid())
  tenant_id       String
  titular_id      String
  tipo_derecho    String    // 'acceso' | 'rectificacion' | 'supresion' | 'oposicion' | 'portabilidad' | 'bloqueo'
  descripcion     String?
  estado          String    @default("pendiente") // 'pendiente' | 'en_revision' | 'resuelta' | 'rechazada'
  fecha_ingreso   DateTime
  fecha_limite    DateTime  // ingreso + 30 días corridos
  respondida_por  String?
  fecha_respuesta DateTime?
  resolucion      String?
  created_at      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([estado, fecha_limite])
}

// Art. 14ter — encargados de tratamiento (DPAs)
model DataProcessor {
  id                String   @id @default(uuid())
  nombre            String
  pais              String
  tipo_datos        String[]
  finalidad         String
  base_contractual  String
  dpa_firmado_fecha DateTime
  dpa_url           String?
  activo            Boolean  @default(true)
  updated_at        DateTime @updatedAt
}

// Art. 14 sexies — incidentes de seguridad
model IncidenteSeguridad {
  id                    String    @id @default(uuid())
  descripcion           String
  datos_afectados       String[]
  titulares_afectados   Int?
  fecha_deteccion       DateTime
  notificacion_agencia  DateTime?
  medidas_adoptadas     String
  estado                String
  created_at            DateTime  @default(now())
}

// ── Pagos / Suscripciones (Flow.cl) ───────────────────────────────────

model Suscripcion {
  id                     String    @id @default(uuid())
  tenant_id              String    @unique
  plan                   String    // 'calidad' | 'integral'
  monto_clp              Int       // monto mensual en CLP (con IVA)
  estado                 String    @default("activa") // 'activa' | 'morosa' | 'suspendida' | 'cancelada'
  dia_cobro              Int       @default(5) // día del mes en que vence el pago
  modo_cobro             String    @default("manual") // 'manual' | 'debito'
  mp_preapproval_id      String?   @unique
  mp_preapproval_status  String?   // 'pending' | 'authorized' | 'paused' | 'cancelled'
  desde                  DateTime  @default(now())
  hasta                  DateTime?
  acceso_hasta           DateTime?
  cancelada_at           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  pagos  Pago[]
  tenant Tenant @relation(fields: [tenant_id], references: [id])
}

model Pago {
  id             String    @id @default(uuid())
  tenant_id      String
  suscripcion_id String?
  periodo        String    // 'YYYY-MM'
  monto_clp      Int
  metodo         String    @default("flow") // 'flow' | 'transferencia' | 'mercadopago' | 'debito'
  estado         String    @default("pendiente") // 'pendiente' | 'pagado' | 'rechazado' | 'anulado'
  flow_token     String?   @unique
  flow_order     Int?
  mp_payment_id  String?   @unique
  pagado_at      DateTime?
  registrado_por String?   // user_id de admin_nucleo cuando metodo='transferencia'
  observacion    String?
  created_at     DateTime  @default(now())

  suscripcion Suscripcion? @relation(fields: [suscripcion_id], references: [id])
  tenant      Tenant       @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, periodo])
  @@index([estado])
}

// ── Plan Integral: gestión ambiental (la registra el asesor) ──────────

model GestionAmbiental {
  id          String    @id @default(uuid())
  tenant_id   String
  tipo        String    // 'segregacion' | 'ventanilla_unica' | 'charla' | 'vencimiento'
  fecha       DateTime
  detalle     String
  folio       String?
  vence       DateTime?
  adjunto_url String?
  created_by  String
  created_at  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, tipo])
  @@index([tenant_id, fecha])
}

// ── Fiscalizaciones y descargos (descargos solo con sello Premium) ────

model Fiscalizacion {
  id         String   @id @default(uuid())
  tenant_id  String
  fecha      DateTime
  autoridad  String
  resultado  String   // 'sin_observaciones' | 'con_observaciones' | 'sumario'
  detalle    String?
  acta_url   String?
  created_by String
  created_at DateTime @default(now())

  descargos Descargo[]
  tenant    Tenant     @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, fecha])
}

model Descargo {
  id               String    @id @default(uuid())
  tenant_id        String
  fiscalizacion_id String?
  titulo           String
  descripcion      String
  estado           String    @default("abierto") // 'abierto' | 'en_revision' | 'presentado' | 'cerrado'
  adjuntos         String[]  @default([])
  respuesta        String?
  solicitado_por   String
  atendido_por     String?
  presentado_at    DateTime?
  cerrado_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  fiscalizacion Fiscalizacion? @relation(fields: [fiscalizacion_id], references: [id])
  tenant        Tenant         @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, estado])
}

// Módulo de tareas — checklist diario para trabajador_local
model Tarea {
  id           String    @id @default(uuid())
  tenant_id    String
  titulo       String
  descripcion  String?
  frecuencia   String    @default("diaria") // 'diaria' | 'semanal' | 'mensual'
  activa       Boolean   @default(true)
  orden        Int       @default(0)
  created_at   DateTime  @default(now())

  completaciones TareaCompletacion[]
  tenant         Tenant  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, activa])
}

model TareaCompletacion {
  id          String   @id @default(uuid())
  tarea_id    String
  user_id     String
  fecha       DateTime @default(now())
  observacion String?

  tarea Tarea @relation(fields: [tarea_id], references: [id])
  user  User  @relation(fields: [user_id], references: [id])

  @@index([tarea_id, fecha])
  @@index([user_id])
}

// Solicitudes de diagnóstico enviadas desde el landing público
model Lead {
  id         String   @id @default(uuid())
  nombre     String
  local      String
  telefono   String
  tipo_local String
  mensaje    String?
  origen     String   @default("landing")
  atendido   Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([telefono, created_at])
}

model Tutorial {
  id           String   @id @default(uuid())
  titulo       String
  descripcion  String   @default("")
  ruta_video   String
  duracion_s   Int?
  activo       Boolean  @default(true)
  roles_acceso String[] @default([])
  creado_por   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([activo, created_at])
}
